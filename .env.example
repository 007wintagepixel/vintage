# ============================================
# Ludo Nexus — Environment Variables Template
# ============================================
# Copy this file to .env and fill in the values.
# For production deployment, set these in Vercel/Render dashboard.

# ---- API (NestJS) ----
NODE_ENV=production
PORT=3001

# ---- Database (PostgreSQL) ----
# Render will provide this automatically when you add PostgreSQL database
DATABASE_URL=postgresql://ludonexus:***@localhost:5432/ludonexus?schema=public

# ---- JWT Secrets ----
# Generate with: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ---- Frontend URL ----
# After Vercel deploy, set this to your Vercel URL
FRONTEND_URL=https://your-app.vercel.app
CORS_ORIGIN=https://your-app.vercel.app
NEXT_PUBLIC_API_URL=https://your-api.onrender.com
NEXT_PUBLIC_SOCKET_URL=https://your-api.onrender.com

# ---- Redis (for Socket.IO adapter, optional) ----
# Render provides this with Redis database
REDIS_URL=redis://localhost:6379

# ---- OTP (dev mode — logs to console) ----
# In production, use an email/SMS provider
OTP_DEV_MODE=true

# ---- Rate Limiting ----
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=100

# ---- Game Settings ----
DEFAULT_TURN_TIME_SECONDS=30
RECONNECTION_GRACE_SECONDS=30

# ---- Wallet (Demo Mode) ----
# All amounts are in demo coins — no real money
WALLET_INITIAL_BALANCE=1000
WALLET_CURRENCY=Demo Coins
PLATFORM_FEE_PERCENT=10

# ---- Feature Flags ----
ENABLE_REAL_MONEY=false
ENABLE_TOURNAMENTS=true
ENABLE_KYC=false
ENABLE_REFERRALS=true